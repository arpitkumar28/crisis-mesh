# SUPABASE CONFIGURATION (Future migration target)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# DATABASE
# Use a non-localhost, production-safe connection string for deployment.
# Example: postgresql://user:password@host:5432/crisis_mesh?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/crisis_mesh?sslmode=require

# AUTHENTICATION
# IMPORTANT: Use a strong random value in every environment.
JWT_SECRET=replace-with-a-secure-random-secret

# MQTT CONFIGURATION
# Production must not fall back to localhost.
MQTT_BROKER_URL=mqtt://broker:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# API CONFIGURATION
API_PORT=3002
API_HOST=0.0.0.0
NODE_ENV=development

# EXTERNAL DATA PROVIDERS
# News is fetched server-side; never expose this key to web or mobile clients.
NEWS_API_KEY=
# Optional: override only when using an approved Open-Meteo-compatible endpoint.
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# NEXT.JS CONFIGURATION
NEXT_PUBLIC_API_URL=https://your-api-domain.example.com/api
NEXT_PUBLIC_WS_URL=https://your-api-domain.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# FLUTTER CONFIGURATION
FLUTTER_API_URL=https://your-api-domain.example.com/api

# AI SERVICE CONFIGURATION
AI_SERVICE_URL=https://your-ai-service.example.com
AI_SERVICE_PORT=5000

# SIMULATOR CONFIGURATION
SIMULATOR_PORT=8080
SIMULATOR_MQTT_BROKER=mqtt://broker:1883

# LOGGING
LOG_LEVEL=info

# CORS
# Never keep localhost in production; this should be set explicitly for each deployment.
CORS_ORIGIN=https://crisis-mesh-eosin.vercel.app

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100
